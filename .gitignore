# =====================
.DS_Store
.AppleDouble
.LSOverride
._*

# =====================
# Windows 系统文件
# =====================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.exe

# =====================
# 测试与覆盖率报告
# =====================
/TestResults/
/Coverage/
/*.trx
/*.coverage

# =====================
# 性能分析文件
# =====================
/FrameCaptures/
/FrameDebugger/
/MemoryCaptures/
/ProfileData/
/*.profiler

# =====================
# Unity 特定分析器
# =====================
/Telemetry/
/UserInterfaceState.json
/UserSettings/

# =====================
# 插件依赖与本地包缓存
# =====================
/Assets/Plugins/Android/*.aar
/Assets/Plugins/iOS/*.a
/Assets/Plugins/x86_64/*.dll
/Assets/Plugins/x86/*.dll
/Packages/com.unity.*/package.json
/Packages/packages-lock.json

# =====================
# 以下为额外针对“大文件错误”的精准屏蔽
# =====================
# 精确匹配你推送时报错的文件/文件夹
/Release/Windows/Battle_Data/resources.assets.resS
/Library/PlayerDataCache/
/Library/ArtifactDB
/Library/PackageCache/com.unity.burst@1.8.18/.Runtime/

# 所有 Burst 运行库（.dll, .so, .dylib）
**/.Runtime/burst-llvm-*.dll
**/.Runtime/*burst-llvm*.so
**/.Runtime/*burst-llvm*.dylib
**/.Runtime/*dsymutil*
**/.Runtime/hostmac/
**/.Runtime/hostlinux/
**/.Runtime/hostwin/

# 所有构建产生的 APK 与 AAR
*.apk
*.aar
*.aab
*/gradle/*/build/
*/gradle/*/outputs/

# Android 构建中间文件
/launcher/build/
/unityLibrary/build/
/*/Temp/gradle/
/*/Library/Bee/Android/
/*/Temp/StagingArea/

# Gradle 包装器（可选，是否需要忽略由团队决定）
/gradle/wrapper/gradle-wrapper.jar
/gradle/wrapper/gradle-wrapper.properties
/gradlew
/gradlew.bat

# 日志文件
*.log
*.log.old
*.log.*
/Logs/

# =====================
# 其他常见 Unity 应忽略项
# =====================
/Assets/AddressableAssetsData/Generate/
/Assets/StreamingAssets/aa/
/Assets/StreamingAssets/UnityCache/
/Assets/Resources/unity_builtin_extra
/Analytics/