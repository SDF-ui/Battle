# =====================
# Unity 自动生成及缓存目录
# =====================
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/

# =====================
# 项目构建输出（Windows, Android, macOS 等）
# =====================
/Release/
/Launcher/
/unityLibrary/
/*.apk
/*.aab
/*.exe
/*.dmg
/*.pkg
/*.msi

# =====================
# 资源数据库 & 资产串行化缓存
# =====================
/Assets/AssetStoreTools*
/AssetStoreCache/
/Assets/AssetStoreCache/
/ProjectSettings/GraphicsSettings.asset.bak
/ProjectSettings/ProjectVersion.txt.bak
/Library/ArtifactDB
/Library/PlayerDataCache/
/Library/Bee/
/Library/PackageCache/*/.Runtime/
/Library/PackageCache/*/.cache/

# =====================
# Burst 编译器缓存及运行时
# =====================
/Library/PackageCache/com.unity.burst@*/.Runtime/
/BurstCache/
/Assets/BurstCache/

# =====================
# 资源生成文件
# =====================
*.resS
*.ress
*.sharedAssets
*.asset
*.meta.backup
*.prefab.bak
*.unity.bak

# =====================
# IDE 及编辑器配置
# =====================
/.vs/
/.idea/
/*.csproj
/*.sln
/*.userprefs
/*.DotSettings
/*.DotSettings.user
/Assembly-CSharp.csproj
/Assembly-CSharp-firstpass.csproj
/Assembly-CSharp-Editor.csproj
/Assembly-CSharp-Editor-firstpass.csproj

# =====================
# Rider 特别文件
# =====================
/.idea/
/*.sln.iml
/*.DotSettings

# =====================
# 版本控制与构建工具临时文件
# =====================
/.git/
/.gitattributes
# /.gitignore
/.gitmodules
/.gitkeep
/.git/
/.github/
/*.log
/*.pid
/*.pid.lock
/*.swp
/*.swo
*~

# =====================
